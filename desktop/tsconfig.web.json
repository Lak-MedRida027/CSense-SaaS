{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild/web",
    "tsBuildInfoFile": ".tsbuild/web.tsbuildinfo"
  },
  "include": ["src/renderer/src", "src/preload/bridge.d.ts"],
  "references": [{ "path": "../shared" }]
}
