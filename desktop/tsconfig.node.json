{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild/node",
    "tsBuildInfoFile": ".tsbuild/node.tsbuildinfo"
  },
  "include": [
    "src/main",
    "src/preload",
    "src/renderer/src/design/tokens/electron.ts",
    "src/renderer/src/design/tokens/primitives.ts",
    "e2e",
    "electron.vite.config.mts",
    "playwright.config.mts",
    "vitest.config.mts"
  ],
  "references": [{ "path": "../shared" }]
}
