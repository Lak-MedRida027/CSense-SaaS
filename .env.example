# CSense environment template. Copy to .env and fill in. Never commit .env.
# Keep this file in sync with server/src/config/env.ts (the zod schema).

# --- Server (Phase 0) ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/csense
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb

# Feature flags (CLAUDE.md open question: default off)
FEATURE_PHISHING=false
FEATURE_CONTINUOUS_REVIEW=false

# --- Authentication and security (Phase 2; ADR 0004) ---
# The API refuses to start without the two secrets below. Each must look generated: base64url
# characters only, >= 43 characters (32 random bytes) with >= 16 distinct characters, and the two
# must differ. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=
# Access token lifetime (1m..30m) and absolute refresh-session lifetime (1h..14d).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt cost: 12..15. Values below 12 are rejected at startup.
BCRYPT_COST=12
# Global per-IP limit (health endpoints are exempt).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Auth limits count FAILED attempts only, within AUTH_RATE_LIMIT_WINDOW_MS.
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Hard limit per (email, client IP): one host cannot lock a user out from another address.
AUTH_LOGIN_MAX_PER_ACCOUNT_IP=10
AUTH_LOGIN_MAX_PER_IP=50
# Failures for one email across ALL IPs per window that raise a warning audit entry (no blocking).
AUTH_LOGIN_TARGETED_THRESHOLD=30
AUTH_REFRESH_MAX_PER_IP=30
# Minimum duration of every FAILED login response (ms, 0..10000), plus random jitter. Hides the
# bcrypt cost difference between old stored hashes and the dummy hash after a BCRYPT_COST change.
AUTH_FAILED_LOGIN_MIN_MS=1000
# Number of reverse-proxy hops in front of the API (0..5). Keep 0 unless a proxy really sets
# X-Forwarded-For; a wrong value lets clients spoof their IP and dodge the rate limits.
TRUST_PROXY_HOPS=0

# --- First administrator (read only by `npm run bootstrap:admin -w @csense/server`) ---
# Not part of the server env. Set them for the one-off run, then REMOVE the password from .env.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Desktop (only MAIN_VITE_* / RENDERER_VITE_* keys reach the Electron bundles) ---
MAIN_VITE_API_BASE_URL=http://localhost:4000/api/v1
