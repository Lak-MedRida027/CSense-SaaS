# CSense environment template. Copy to .env and fill in. Never commit .env.
# Keep this file in sync with server/src/config/env.ts (the zod schema).

# --- Server (Phase 0) ---
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/csense
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb

# Feature flags (CLAUDE.md open question: default off)
FEATURE_PHISHING=false
FEATURE_CONTINUOUS_REVIEW=false

# --- Authentication and security (Phase 2; ADR 0004) ---
# The API refuses to start without the two secrets below. Each must look generated: base64url
# characters only, >= 43 characters (32 random bytes) with >= 16 distinct characters, and the two
# must differ. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
REFRESH_TOKEN_SECRET=
# Third secret (Phase 4, ADR 0012): keys the audit-log hash chain. Same rules and the same
# generation command; it must differ from the two above. Losing it makes the chain unverifiable;
# leaking it allows forging entries. Also read by bootstrap:admin, gamification:reconcile and audit:verify.
AUDIT_CHAIN_SECRET=
# Access token lifetime (1m..30m) and absolute refresh-session lifetime (1h..14d).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# bcrypt cost: 12..15. Values below 12 are rejected at startup.
BCRYPT_COST=12
# Global per-IP limit (health endpoints are exempt).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
# Auth limits count FAILED attempts only, within AUTH_RATE_LIMIT_WINDOW_MS.
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Hard limit per (email, client IP): one host cannot lock a user out from another address.
AUTH_LOGIN_MAX_PER_ACCOUNT_IP=10
AUTH_LOGIN_MAX_PER_IP=50
# Failures for one email across ALL IPs per window that raise a warning audit entry (no blocking).
AUTH_LOGIN_TARGETED_THRESHOLD=30
AUTH_REFRESH_MAX_PER_IP=30
# Minimum duration of every FAILED login response (ms, 0..10000), plus random jitter. Hides the
# bcrypt cost difference between old stored hashes and the dummy hash after a BCRYPT_COST change.
AUTH_FAILED_LOGIN_MIN_MS=1000
# Number of reverse-proxy hops in front of the API (0..5). Keep 0 unless a proxy really sets
# X-Forwarded-For; a wrong value lets clients spoof their IP and dodge the rate limits.
TRUST_PROXY_HOPS=0

# --- Learning engine (Phase 3; ADR 0007) ---
# How long a started quiz or final-test session stays open (5m..4h). A submission after this
# counts as an expired attempt.
ASSESSMENT_SESSION_TTL=60m
# A hook (XP, badges, risk) slower than this many ms is dropped and logged; the attempt stays saved.
LEARNING_HOOK_TIMEOUT_MS=2000
# Starting a session again within this many seconds returns the open one (0 disables, max 60).
ASSESSMENT_START_REUSE_SECONDS=5
# After this many failed attempts in a row at one quiz or the final test, new sessions for it are
# blocked for ASSESSMENT_COOLDOWN_MINUTES (1..1440). Abandoned and expired attempts count; a pass
# resets the count. Each cooldown writes a warning audit entry.
ASSESSMENT_COOLDOWN_AFTER_FAILS=3
ASSESSMENT_COOLDOWN_MINUTES=15
# Per-employee limit on starting quiz / final-test sessions: SESSION_START_RATE_MAX per window.
SESSION_START_RATE_MAX=10
SESSION_START_RATE_WINDOW_MS=600000

# --- Gamification, risk and governance (Phase 4; ADR 0009-0012) ---
# How often the in-process sweeper repairs missed XP, badge, risk and audit-outbox writes.
# "0" disables it; otherwise 1m..1h.
RECONCILE_SWEEP_INTERVAL=5m
# Repeated quiz failures are flagged to the security team: this many assessment cooldowns on the
# SAME quiz or final test within the window open an elevated escalation (1..20; window 1h..90d).
ESCALATE_AFTER_COOLDOWNS=2
ESCALATE_COOLDOWN_WINDOW=7d
# An active employee with an unfinished curriculum and no progress for this many days is flagged
# to the security team (disengaged_unassessed or disengaged_no_progress). 1..365.
DISENGAGED_AFTER_DAYS=14
# Resolving a critical, management-tier or risk_accepted escalation needs a different administrator
# than the one who acknowledged it. Set to false only in single-administrator organisations; such
# resolutions are then marked sameAdmin and audited as warnings.
ESCALATION_REQUIRE_SECOND_ADMIN=true

# --- Learning content seed (development and test only; see README) ---
# The seed refuses to run unless NODE_ENV is development or test, and refuses a non-local MongoDB
# host unless SEED_ALLOW_REMOTE=true. --reset additionally needs --confirm=<database name>.
# SEED_ALLOW_REMOTE=false

# --- First administrator (read only by `npm run bootstrap:admin -w @csense/server`) ---
# Not part of the server env. Set them for the one-off run, then REMOVE the password from .env.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Desktop (only MAIN_VITE_* / RENDERER_VITE_* keys reach the Electron bundles) ---
MAIN_VITE_API_BASE_URL=http://localhost:4000/api/v1
